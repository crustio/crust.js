{
  "name": "@crustnetwork/ipfs-w3auth-aptos",
  "version": "0.0.3",
  "description": "Aptos authentication of IPFS W3Auth",
  "main": "./src/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build:types": "npx ts-node src/scripts/generate.ts",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "pub": "tsc && copyfiles ./package.json ./build && cd build && npm publish --access public"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "copyfiles": "latest",
    "@types/node": "^14.14.31",
    "@types/lodash": "^4.14.172",
    "gts": "^3.1.0",
    "typescript": "^4.1.3"
  }
}
