{
  "name": "@crustnetwork/ipfs-w3auth-handler",
  "version": "0.0.19",
  "description": "IPFS W3Auth express middleware",
  "main": "./src/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build:types": "npx ts-node src/scripts/generate.ts",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "pub": "tsc && copyfiles ./package.json ./build && cd build && npm publish --access public"
  },
  "resolutions": {
    "usb": "1.8.x",
    "utf-8-validate": "5.0.6",
    "bufferutil": "4.0.4"
  },
  "dependencies": {
    "@crustnetwork/ipfs-w3auth-avalanche": "0.x",
    "@crustnetwork/ipfs-w3auth-ethereum": "0.x",
    "@crustnetwork/ipfs-w3auth-solana": "0.x",
    "@crustnetwork/ipfs-w3auth-substrate": "0.x",
    "@crustnetwork/ipfs-w3auth-flow": "0.x",
    "@crustnetwork/ipfs-w3auth-elrond": "0.x",
    "@crustnetwork/ipfs-w3auth-xx": "0.x",
    "@crustnetwork/ipfs-w3auth-aptos": "0.x",
    "@crustnetwork/ipfs-w3auth-algorand": "0.x",
    "@crustnetwork/ipfs-w3auth-ton": "0.x",
    "express": "^4.17.1",
    "lodash": "^4.17.21",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "copyfiles": "latest",
    "@types/express": "^4.17.13",
    "@babel/runtime": "^7.13.2",
    "@types/node": "^14.14.31",
    "gts": "^3.1.0",
    "typescript": "^4.1.3"
  }
}
